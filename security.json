{
  "$schema": "https://raw.githubusercontent.com/marincountygov/marin-os/main/schemas/security.schema.json",
  "$comment": "Marin Links is a static MarinOS GitHub Pages app. Long tracking links and QR images are generated locally. When a user explicitly chooses Create short link(s), the completed destination and non-sensitive marketing metadata are POSTed to Marin Links Server, which stores a private destination for short-link resolution. Stats reads public aggregate JSON. The CSP authorizes this server and MarinOS/Brand information sources.",
  "schema": 1,
  "profile": "internal",
  "securityTxt": {
    "enabled": true,
    "contact": [
      "mailto:innovation@marincounty.gov"
    ],
    "preferredLanguages": [
      "en"
    ],
    "expires": "2027-10-20T00:00:00.000Z"
  },
  "transport": {
    "httpsRequired": true,
    "httpRedirect": true,
    "hsts": {
      "status": "inherited-from-platform"
    }
  },
  "headers": {
    "contentTypeOptions": {
      "status": "not-achievable",
      "notes": "GitHub Pages does not serve custom HTTP response headers."
    },
    "referrerPolicy": {
      "status": "enabled-via-meta",
      "value": "strict-origin-when-cross-origin"
    },
    "permissionsPolicy": {
      "status": "not-achievable",
      "notes": "GitHub Pages does not serve custom HTTP response headers."
    },
    "frameProtection": {
      "status": "not-achievable",
      "notes": "Requires a header (X-Frame-Options) or a directive meta-delivered CSP ignores (frame-ancestors); neither is available on GitHub Pages."
    }
  },
  "csp": {
    "deliveryMechanism": "meta",
    "directives": {
      "default-src": [
        "'self'"
      ],
      "script-src": [
        "'self'"
      ],
      "style-src": [
        "'self'"
      ],
      "img-src": [
        "'self'",
        "data:",
        "https://marincountygov.github.io/marin-brand/brands/"
      ],
      "font-src": [
        "'self'"
      ],
      "connect-src": [
        "'self'",
        "https://l.marinhhs.org",
        "https://marincountygov.github.io/marin-brand/brands.json",
        "https://marincountygov.github.io/marin-os/catalog.json",
        "https://marincountygov.github.io/marin-os/data/lighthouse.json",
        "https://marincountygov.github.io/marin-os/data/tech.json",
        "https://api.github.com"
      ],
      "object-src": [
        "'none'"
      ],
      "base-uri": [
        "'self'"
      ],
      "form-action": [
        "'self'"
      ]
    }
  },
  "authentication": {
    "required": false
  },
  "authorization": {
    "required": false,
    "serverSideEnforced": false
  },
  "data": {
    "collectsUserData": false,
    "collectsSensitiveData": false,
    "storesPersonalInformation": false,
    "acceptsUserSubmittedContent": true,
    "externalDataSources": [
      "https://marincountygov.github.io/marin-os/catalog.json",
      "https://marincountygov.github.io/marin-os/data/lighthouse.json",
      "https://marincountygov.github.io/marin-os/data/tech.json",
      "https://api.github.com",
      "https://l.marinhhs.org/s/api/v1/"
    ]
  },
  "dependencies": {
    "lockfileRequired": false,
    "runtimeCdnPolicy": "see marin-digital-standards/product-design/runtime-dependencies.md",
    "thirdPartyDependencyReview": true,
    "dependencyScanning": {
      "status": "enabled",
      "provider": "github-advanced-security"
    }
  },
  "secrets": {
    "clientSideSecretsProhibited": true,
    "committedSecretsProhibited": true,
    "repositoryScanning": {
      "status": "enabled",
      "provider": "github-advanced-security"
    }
  },
  "monitoring": {
    "secretScanning": {
      "status": "enabled",
      "provider": "github-advanced-security"
    },
    "pushProtection": {
      "status": "enabled",
      "provider": "github-advanced-security"
    },
    "dependabotSecurityUpdates": {
      "status": "enabled",
      "provider": "github-advanced-security"
    }
  },
  "exceptions": [
    {
      "control": "Clickjacking protection (frame-ancestors / X-Frame-Options)",
      "reason": "GitHub Pages cannot serve custom HTTP headers, and meta-delivered CSP ignores frame-ancestors.",
      "riskDescription": "The app has no sign-in or stored user data. A framed copy could still mislead a user into making the wrong QR code. The interface shows the final link and tells users to scan-test the code before sharing it.",
      "owner": "County of Marin",
      "expires": "2027-10-20"
    },
    {
      "control": "MIME-sniffing protection (X-Content-Type-Options) and Permissions-Policy",
      "reason": "Both require a real HTTP response header, which GitHub Pages does not serve.",
      "riskDescription": "This is a standing GitHub Pages hosting gap. Marin Links does not accept file uploads, run remote code, or store personal data in the browser. Its CSP blocks external scripts and object content.",
      "owner": "County of Marin",
      "expires": "2027-10-20"
    }
  ],
  "publicSecurity": {
    "lastReviewed": "2026-10-28",
    "controls": [
      "HTTPS",
      "Content Security Policy",
      "Local QR processing",
      "Dependency monitoring",
      "Secret scanning",
      "Server-enforced short-link creation policy",
      "No client-side credentials"
    ],
    "data": {
      "collectsPersonalData": false
    }
  },
  "review": {
    "lastReviewed": "2026-10-28",
    "owner": "County of Marin"
  }
}
