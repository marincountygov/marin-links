{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agencies.schema.json",
  "title": "County of Marin agencies and departments",
  "type": "object",
  "required": ["schemaVersion", "title", "organization", "agencies"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string" },
    "organization": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "source": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "agencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agency" }
    }
  },
  "$defs": {
    "agency": {
      "type": "object",
      "required": ["id", "name", "type", "parent", "url", "status"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Permanent. A department is a short lowercase name. A division is its department's id, a slash, and a short lowercase name.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)?$"
        },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["department", "division"] },
        "parent": { "type": ["string", "null"], "description": "The id of the department a division belongs to. Null for a department." },
        "url": { "type": "string", "pattern": "^https://" },
        "status": { "enum": ["active", "retired"] },
        "aliases": { "type": "array", "items": { "type": "string" }, "description": "Other names or short names people use." }
      }
    }
  }
}
